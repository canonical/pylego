{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "github>canonical/identity-credentials-workflows//renovate.json5#v3.1.3",
  ],
  enabledManagers: ["pep621", "github-actions", "gomod"],
  bumpVersion: "patch",
  packageRules: [
    {
      matchManagers: ["github-actions"],
      commitMessagePrefix: "chore: ",
    },
    {
      matchManagers: ["gomod"],
      matchFileNames: ["src/pylego/**"],
      groupName: "go_dependencies",
      commitMessagePrefix: "chore: ",
    },
  ],
}
